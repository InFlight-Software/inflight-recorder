{
	"type": "module",
	"scripts": {
		"build": "dotenv -e .env -- turbo run build",
		"cap-setup": "dotenv -e .env -- node scripts/setup.js",
		"dev": "dotenv -e .env -- turbo run dev --env-mode=loose --ui tui",
		"dev:desktop": "pnpm run --filter=@inflight/desktop dev",
		"format": "pnpm exec biome check --write",
		"lint": "pnpm exec biome lint",
		"tauri:build": "dotenv -e .env -- pnpm --dir apps/desktop tauri build --verbose",
		"typecheck": "pnpm tsc -b",
		"env-setup": "node scripts/env-cli.js",
		"check-tauri-versions": "node scripts/check-tauri-plugin-versions.js",
		"clean": "find . -name node_modules -o -name .next -o -name .output -o -name .turbo -o -name dist -type d -prune | xargs rm -rf",
		"with-env": "dotenv -e .env --",
		"doctor": "node scripts/doctor.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@clack/prompts": "^0.10.0",
		"dotenv-cli": "latest",
		"tsdown": "^0.15.6",
		"turbo": "^2.9.14",
		"typescript": "^5.8.3"
	},
	"packageManager": "pnpm@10.30.3",
	"name": "inflight",
	"engines": {
		"node": ">=20"
	},
	"pnpm": {
		"overrides": {
			"diff@>=8": ">=8.0.3",
			"h3@>=1": ">=1.15.9",
			"esbuild@>=0.21": ">=0.25.0",
			"vite@>=6 <7": ">=6.4.2 <7",
			"tar@<7": ">=7.5.11",
			"serialize-javascript@>=7 <8": ">=7.0.5 <8",
			"picomatch@>=2 <3": ">=2.3.2 <3",
			"picomatch@>=4 <5": ">=4.0.4 <5",
			"brace-expansion@>=2 <3": ">=2.0.3 <3",
			"yaml@>=2 <3": ">=2.8.3 <3",
			"node-forge@>=1 <2": ">=1.4.0 <2",
			"defu@>=6 <7": ">=6.1.5 <7",
			"lodash@>=4 <5": ">=4.18.0 <5",
			"lodash-es@>=4 <5": ">=4.18.0 <5",
			"drizzle-orm": ">=0.45.2",
			"brace-expansion@>=1 <2": ">=1.1.13 <2",
			"follow-redirects@>=1 <2": ">=1.16.0 <2",
			"serialize-javascript@<7": ">=7.0.5",
			"vite@>=5 <6": "6.4.2",
			"uuid@>=9 <10": ">=14.0.0",
			"uuid@>=11 <12": ">=14.0.0",
			"nitropack@>=2 <3": ">=2.13.4 <3",
			"postcss@>=8 <9": ">=8.5.10 <9"
		}
	}
}
